   "id": "c1be104b-0a77-4a59-9193-575676103039",
   "metadata": {},
   "outputs": [],
   "source": [
    "df2 = df.copy()\n",
    "\n",
    "df2 = df2.drop_duplicates()\n",
    "df2 = df2.fillna(0)\n",
    "\n",
    "df2 = df2.sort_values(\"income\")\n",
    "\n",
    "df2 = df2.reset_index(drop = True)\n",
    "\n",
    "df2.to_csv(\"sorted_data.csv\")"
   ]
  },
